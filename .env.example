# ===================================================
# REDX CINEMA - Environment Configuration
# ===================================================

# Public Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="REDX CINEMA"

# TMDB (The Movie Database) API Configuration
# Get your free TMDB API Read Access Token or API Key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_v3_key_or_bearer_token
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Supabase Database & Auth Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key-do-not-expose-client-side

# Admin Credentials / Role Guard
ADMIN_SECRET_KEY=redx_admin_secret_access_token_2025
ADMIN_EMAIL=admin@redxcinema.com

# Monetization & Ad Network Configuration
NEXT_PUBLIC_ADS_ENABLED=true
NEXT_PUBLIC_PRE_ROLL_ENABLED=true
NEXT_PUBLIC_SPONSOR_NAME="NordVPN Secure Streaming"
NEXT_PUBLIC_SPONSOR_URL="https://nordvpn.com"
NEXT_PUBLIC_AFFILIATE_DISCLOSURE=true
